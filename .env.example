# 在本地复制为 .env，填写自己的密钥与接口地址；勿提交 .env。
CLOSEAI_API_KEY=
CLOSEAI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
DATA_DIR=data
MAX_UPLOAD_MB=50
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
API_TIMEOUT=60
API_MAX_RETRIES=1
API_MAX_CONCURRENT=4
API_QUEUE_TIMEOUT=10
MAX_CONTEXT_CHARS=12000
# 留空关闭重排；启用前安装可选依赖并下载/缓存适合中文的 CrossEncoder 模型。
RERANK_MODEL=
RERANK_CANDIDATES=15
# LangSmith 为可选项；打开后会把问题、证据、工具参数发送到配置的 LangSmith 项目。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dual-carbon-rag
# 自托管 LangSmith 时填写；使用官方服务时留空并由 SDK 选择默认地址。
LANGSMITH_ENDPOINT=
# 可选余弦距离上限（越小越近）；必须经标注样本校准，不代表可信度。
MAX_COSINE_DISTANCE=
